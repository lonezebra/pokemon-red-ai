.venv/
__pycache__/
*.pyc

.DS_Store

# The ROM itself is never committed (copyright), and the environment
# restores it rather than this repo.
roms/

# saves/, screenshots/, and models/ were fully ignored until a container
# restart rolled the filesystem back roughly a day and destroyed work
# that cost hours of compute -- most damagingly screenshots/
# forest_map_meta.json, which rewards/forest_rewards.py reads at import
# time, so losing it stopped the forest environment from even loading.
# Everything the repo cannot rebuild for free is now tracked; only what
# is genuinely cheap to regenerate, or pure per-round scratch, stays
# ignored.

# saves/: every .state is a verified checkpoint that took a scripted
# playthrough (and sometimes a full survey) to reach. ~3.4MB, write-once.
#
# forest_survey_last_trainer.state is the exception, and the reason the
# rule can't just be "all .state files": survey_viridian_forest.py dumps
# it on every trainer encounter purely so a failure can be inspected
# afterwards (nothing ever loads it back), so it's rewritten every few
# minutes for the length of a survey. Tracking it means a running survey
# leaves the working tree permanently dirty with a file no restart would
# ever want restored.
saves/**
!saves/**/
!saves/**/*.state
saves/forest_survey_last_trainer.state

# models/: the trained policies and, critically, the *_parallel_state
# files -- train_navigation_parallel.initial_state() resumes a run from
# those, so tracking them turns a restart into the loss of one round
# rather than a whole training run. parallel_workers/ and
# parallel_survey_workers/ are per-round scratch the next round
# overwrites anyway, and the .pkl worker dumps are 2MB apiece.
models/**
!models/**/
!models/*.zip
!models/*_q_table.json
!models/*_parallel_state.json
# The curriculum driver's per-stage record (which stages mastered, in how
# many rounds, at what accuracy) -- the primary readout of whether the
# curriculum works at all, and not reconstructable after the fact.
!models/*_stages.json
models/parallel_workers/
models/parallel_survey_workers/
# The whole-game PPO run is the one place the "track the trained policy"
# rule above does not fit. Those policies are small and written once; this
# one is 7.8MB (it carries a screen CNN, not a 6-number MLP) and
# CheckpointCallback rewrites it every 100k steps, so a single 10M-step run
# would push the better part of a gigabyte of near-identical blobs into
# history -- permanently, since git keeps every version.
#
# Losing them costs GPU hours, not the irreplaceable hand-verified work the
# save states and survey metadata represent, and a run resumes from whatever
# checkpoint is on disk regardless. Promoting a finished policy into the repo
# stays a deliberate `git add -f`, not something a background checkpoint does
# by accident.
models/whole_game_ppo/
models/whole_game_ppo_*/
models/whole_game_tensorboard/
models/whole_game_rollouts/

# screenshots/: the *_meta.json survey results are the expensive part --
# tiles, exits, and the walkable-adjacency graph an exhaustive parallel
# survey had to establish. The panorama PNGs are kept too, since they are
# the visual proof a map is what it claims to be (map 2 is Pewter City
# because its panorama shows a labelled GYM and MART), and all 74 of them
# together are under 300KB. The GIFs are not: 18MB of per-round training
# demos that any later round makes obsolete.
screenshots/**
!screenshots/**/
!screenshots/**/*_meta.json
!screenshots/**/*.png
# The mashup GIFs are the exception to "GIFs are disposable": they are the
# project's showcase artifacts (a trained agent's full run, stitched), cost
# real rollout compute to regenerate, and total under 1MB -- unlike the
# ~18MB of per-round training demos, which any later round supersedes and
# which stay ignored. Their rollout JSONs ride along: they are the recipe
# the GIF was rendered from.
!screenshots/mashups/**/*.gif
!screenshots/mashups/**/*.json
# ...but the whole-game eval renders are not that exception. The un-ignore
# above was written when a mashup was one map and under 1MB; the whole-game
# renderer emits a folder of per-map GIFs for *every checkpoint evaluated*
# (139MB and counting), all regenerable from render_whole_game_runs.py plus
# a rollout JSON. Same story as the checkpoints themselves: bulk output of
# a run, not hand-verified work.
screenshots/mashups/whole_game_*/

# The archived track's training scratch: 96MB of per-round demo frames the
# old per-segment trainers wrote. Kept on disk with the archive, but it is
# exactly the "any later round supersedes it" class the GIF rule above
# already refuses.
archive/segmented-skills/screenshots/training_scratch/
